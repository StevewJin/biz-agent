# ============================================================
# BizAgent environment variables
# Copy to .env and adjust as needed (.env is gitignored)
#   cp .env.example .env
# ============================================================

# ---------------- Database (required) ----------------
# With docker compose: jdbc:postgresql://postgres:5432/bizagent
BIZAGENT_DB_URL=jdbc:postgresql://localhost:5432/bizagent
BIZAGENT_DB_USERNAME=bizagent
BIZAGENT_DB_PASSWORD=bizagent
BIZAGENT_DB_DRIVER=org.postgresql.Driver

# ---------------- Security (required in production) ----------------
# JWT signing key: Base64, must decode to >= 64 bytes
# Generate: openssl rand -base64 64 | tr -d '\n'
BIZAGENT_JWT_SECRET=

# AES master key: encrypts LLM API keys / datasource passwords / API auth config
# Accepts a 32-byte Base64 or Hex value; when empty, data/master.key is generated on first start (back it up!)
# Generate: openssl rand -base64 32
BIZAGENT_MASTER_KEY=

# Allowed CORS origins, comma separated; empty means same-origin only
# e.g. http://localhost:5173,https://bizagent.example.com
BIZAGENT_CORS_ORIGINS=

# Allow-list of private hosts for API tools (cloud metadata and loopback are always blocked)
# e.g. 10.20.30.40,erp.internal.example.com
BIZAGENT_OUTBOUND_HOSTS=

# ---------------- LLM provider ----------------
# Any OpenAI-compatible endpoint works
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---------------- Data directories ----------------
BIZAGENT_DATA_DIR=./data
BIZAGENT_EXT_HOME=./data/extensions
BIZAGENT_DRIVER_DIR=./data/drivers
BIZAGENT_WORKSPACE_DIR=./data/workspace
APP_EXPORT_DIR=./data/exports

# ---------------- Logging and debugging ----------------
BIZAGENT_LOG_LEVEL=INFO
# Dump full LLM request bodies and SSE payloads (contains business data; debugging only)
BIZAGENT_LOG_RAW_PAYLOAD=false

# ---------------- docker compose only ----------------
# Password for the postgres container; keep it in sync with BIZAGENT_DB_PASSWORD
POSTGRES_PASSWORD=bizagent
