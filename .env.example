# ============================================================
# BizAgent 环境变量示例
# 复制为 .env 后按需修改（.env 已在 .gitignore 中，不会被提交）
#   cp .env.example .env
# ============================================================

# ---------------- 数据库（必需） ----------------
# 本地 composer 方式: jdbc:postgresql://localhost:5432/bizagent
BIZAGENT_DB_URL=jdbc:postgresql://localhost:5432/bizagent
BIZAGENT_DB_USERNAME=bizagent
BIZAGENT_DB_PASSWORD=bizagent
BIZAGENT_DB_DRIVER=org.postgresql.Driver

# ---------------- 安全（生产环境必需） ----------------
# JWT 签名密钥：Base64 编码，解码后长度必须 >= 64 字节
# 生成: openssl rand -base64 64 | tr -d '\n'
BIZAGENT_JWT_SECRET=

# AES 主密钥：用于加密 LLM API Key / 数据源密码 / 接口鉴权配置
# 支持 32 字节的 Base64 或 Hex；留空则首次启动自动生成 data/master.key（必须离线备份）
# 生成: openssl rand -base64 32
BIZAGENT_MASTER_KEY=

# 允许跨域的前端地址，逗号分隔；留空表示仅同源访问
# 例: http://localhost:5173,https://bizagent.example.com
BIZAGENT_CORS_ORIGINS=

# 接口调用放行的内网主机白名单（云元数据地址与回环地址始终禁止）
# 例: 10.20.30.40,erp.internal.example.com
BIZAGENT_OUTBOUND_HOSTS=

# ---------------- LLM 供应商 ----------------
# 任意 OpenAI 兼容端点均可
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---------------- 数据目录 ----------------
BIZAGENT_DATA_DIR=./data
BIZAGENT_EXT_HOME=./data/extensions
BIZAGENT_DRIVER_DIR=./data/drivers
BIZAGENT_WORKSPACE_DIR=./data/workspace
APP_EXPORT_DIR=./data/exports

# ---------------- 日志与调试 ----------------
BIZAGENT_LOG_LEVEL=INFO
# 是否打印完整 LLM 请求体与 SSE 原文（含业务数据，仅调试开启）
BIZAGENT_LOG_RAW_PAYLOAD=false

# ---------------- docker compose 专用 ----------------
# postgres 容器初始化密码，需与 BIZAGENT_DB_PASSWORD 保持一致
POSTGRES_PASSWORD=bizagent
