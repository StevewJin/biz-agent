{
  "code": "builtin_http",
  "name": "业务系统接口调用",
  "version": "1.0.0",
  "vendor": "bizagent",
  "description": "调用已在业务系统接口管理中登记的 HTTP 接口",
  "packType": "declarative",
  "apiVersion": "1",
  "tools": [
    {
      "code": "call",
      "kind": "http",
      "displayName": "接口调用",
      "description": "调用已登记的业务系统接口。必须提供 endpoint（接口编码，技能提示词中会给出）；其余参数按接口的入参说明放在 params 中。平台自动注入鉴权信息，不需要也不能传入 URL 或密钥。",
      "renderType": "json",
      "riskLevel": "medium",
      "anonymousAllowed": false,
      "parameterSchema": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "description": "接口编码"
          },
          "params": {
            "type": "object",
            "description": "接口业务参数（路径参数、查询参数或请求体字段）"
          }
        },
        "required": ["endpoint"]
      }
    }
  ]
}
