{
  "code": "builtin_export",
  "name": "数据导出",
  "version": "1.0.0",
  "vendor": "bizagent",
  "description": "将结构化数据导出为 Excel 或 CSV 文件",
  "packType": "declarative",
  "apiVersion": "1",
  "renderers": [
    {
      "type": "export",
      "entry": "",
      "toolKeys": ["builtin_export__export_file"]
    }
  ],
  "tools": [
    {
      "code": "export_file",
      "kind": "export",
      "displayName": "文件导出",
      "description": "将结构化数据导出为 Excel(.xlsx) 或 CSV 文件供用户下载。需要 headers(表头)、rows(数据行，每行长度与表头一致)、filename(不含扩展名)，format 可选 xlsx 或 csv。",
      "renderType": "export",
      "riskLevel": "medium",
      "anonymousAllowed": false,
      "parameterSchema": {
        "type": "object",
        "properties": {
          "filename": { "type": "string", "description": "文件名（不含扩展名）" },
          "format": {
            "type": "string",
            "description": "导出格式: xlsx 或 csv",
            "enum": ["xlsx", "csv"]
          },
          "headers": {
            "type": "array",
            "description": "表头列名数组",
            "items": { "type": "string" }
          },
          "rows": {
            "type": "array",
            "description": "数据行数组，每行元素与表头顺序一致",
            "items": {
              "type": "array",
              "description": "单行数据"
            }
          }
        },
        "required": ["filename", "headers", "rows"]
      }
    }
  ]
}
